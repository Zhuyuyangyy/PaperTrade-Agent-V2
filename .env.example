# OpenAlpha — Binance Demo Trading 凭据模板
#
# 用法：把这个文件复制成 .env，填上你自己的 Demo Key，然后重跑命令。
#   cp .env.example .env       （Windows: copy .env.example .env）
#
# 读取顺序（只补缺失项，环境变量优先级更高）：
#   1. $BINANCE_DEMO_API_KEY / $BINANCE_DEMO_API_SECRET（进程环境变量）
#   2. <--root 指定目录>/.env
#   3. 当前工作目录/.env
#   4. 仓库根目录/.env
#
# 只认下面两个键，.env 里写其他键会被忽略。
#
# 注意：.gitignore 已忽略 .env 与 .env.*，只有本模板会被提交。
# 绝不要把 key/secret 提交进仓库、写进代码或贴到聊天窗口。

BINANCE_DEMO_API_KEY=填这里_DEMO_API_KEY
BINANCE_DEMO_API_SECRET=填这里_DEMO_API_SECRET

# 决策模型（可选；不填则 deepseek_5m 走 HOLD，rules_5m 仍可跑）
DEEPSEEK_API_KEY=sk-填这里
