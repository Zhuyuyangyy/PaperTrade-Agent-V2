{
  "_comment": "六 Agent 流水线配置。Paper only：无钱包、无签名、无真实订单。",
  "mode": "dry_run",
  "search": {
    "max_candidates": 400
  },
  "risk": {
    "top_n": 3,
    "min_score": 45.0
  },
  "smart_money": {
    "min_notional_usd": 20000.0,
    "recent_hours": 24,
    "limit": 12,
    "score_boost": 6.0
  },
  "entry": {
    "stop_loss_pct": -12.0,
    "max_entries_per_round": 2
  },
  "exit": {
    "enabled": true
  },
  "judge": {
    "enabled": true,
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat",
    "timeout_seconds": 25,
    "max_per_round": 3,
    "rule_weight": 0.6,
    "llm_weight": 0.4,
    "_note": "LLM 只对通过 veto 的候选研判，只重排不放行；无 key 或调用失败自动降级为规则分。换服务商改 base_url/model/api_key_env 即可（OpenAI 兼容）。"
  }
}
