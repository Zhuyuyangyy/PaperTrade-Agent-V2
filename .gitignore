.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.sqlite*
*.db
*.db-*
data/*
!data/.gitkeep
!data/paper_dashboard.html
user_data/signals/*
!user_data/signals/.gitkeep
user_data/data/
user_data/logs/
user_data/backtest_results/
user_data/hyperopt_results/
user_data/plot/

# Runtime marks are fetched from public tickers and must not be committed.
user_data/marks/*
!user_data/marks/.gitkeep

# Each Dry-run account has its own writable runtime directory.
runtime/*/*.sqlite*
runtime/*/*.json
runtime/*/*.log
!runtime/baseline/.gitkeep
!runtime/hybrid/.gitkeep
!runtime/fast/.gitkeep
!runtime/copywatch/.gitkeep

# MemeHunter E runtime artifacts
runtime/memehunter/*.sh

# Loop single-instance lock, machine local
runtime/memehunter/.loop.pid
runtime/copywatch/.loop.pid

# Local LLM credentials, never commit
user_data/judge.local.json
_backups/
runtime/memehunter/loop.sh
STOP

# runtime lock artifacts
*.pid

# Internal agent state (daily memory logs, automation notes, night-shift
# plans). These are working notes, not product artifacts: local absolute
# paths and internal decisions do not belong in a public repo. The distilled,
# publishable version lives in docs/.
.workbuddy/

# local runtime logs (never commit)
logs/

# V4 大体积行情快照：可从 data/v3_market/ 用
# scripts/backfill_market.py + research/v4/build_s2b_entries.py 一键重建。
# 只提交脚本与报告，不提交 1.6M 的重复数据。
research/v4/diagnostic/*_3y.csv
