{
  "interval": "1h",
  "venue": "futures",
  "fee_rate": 0.0002,
  "funding": true,
  "exit": {
    "take_profit": 0.03,
    "stop_loss": -0.08,
    "timeout_bars": 24
  },
  "control": {
    "enabled": true,
    "n_random": 200,
    "seed": 42
