  "name": "case4-rsi-dip-btc-1h-maker",
  "hypothesis": "case1 同策略改用 maker 限价成交（挂信号根收盘价，穿越才成交）",
  "symbol": "BTCUSDT",
  "fill_model": "maker",
  "signals": {
    "kind": "rule",
    "rule": "rsi_below",
    "period": 14,
    "threshold": 30,
    "side": "long"
  }
